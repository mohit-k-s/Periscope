{
  "name": "periscope",
  "description": "Periscope — Sub-second RDS Performance Insights, 5-minute selective snapshot archive & toxic query detection",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "periscope": "server/cli.ts",
    "pi-snapshot": "server/cli.ts"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test --test-reporter spec 'tests/**/*.test.ts'",
    "periscope": "tsx server/cli.ts",
    "periscope:run": "tsx server/cli.ts run",
    "periscope:daemon": "tsx server/cli.ts daemon",
    "periscope:onboard": "tsx server/cli.ts onboard",
    "periscope:offboard": "tsx server/cli.ts offboard",
    "periscope:targets": "tsx server/cli.ts onboarded",
    "periscope:list": "tsx server/cli.ts list",
    "periscope:inspect": "tsx server/cli.ts inspect",
    "periscope:anomalies": "tsx server/cli.ts anomalies",
    "periscope:cost": "tsx server/cli.ts cost",
    "snapshot:run": "tsx server/cli.ts run",
    "snapshot:daemon": "tsx server/cli.ts daemon",
    "snapshot:onboard": "tsx server/cli.ts onboard",
    "snapshot:offboard": "tsx server/cli.ts offboard",
    "snapshot:targets": "tsx server/cli.ts onboarded",
    "snapshot:list": "tsx server/cli.ts list",
    "snapshot:inspect": "tsx server/cli.ts inspect",
    "snapshot:anomalies": "tsx server/cli.ts anomalies",
    "snapshot:cost": "tsx server/cli.ts cost"
  },
  "dependencies": {
    "@aws-sdk/client-pi": "^3.758.0",
    "@aws-sdk/client-rds": "^3.758.0",
    "@aws-sdk/client-sts": "^3.758.0",
    "@aws-sdk/credential-providers": "^3.758.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
